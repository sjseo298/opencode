{
  "$schema": "https://opencode.ai/config.json",
  "permission": {},
  "references": {
    "effect": {
      "repository": "github.com/Effect-TS/effect-smol",
      "description": "Use for Effect v4 and effect-smol implementation details"
    },
    "opencode-local": {
      "path": "~/.local/share/opencode",
      "description": "Contains opencode logs and data"
    }
  },
  "mcp": {},
  "agent": {
    "explore": {
      "permission": {
        "azuredevops-mcp_*": "allow",
        "list_mcp_resources": "allow",
        "list_mcp_resource_templates": "allow",
        "read_mcp_resource": "allow"
      }
    }
  },
  "plugin": [
    ".opencode/plugins/compaction-todo.ts",
    [
      ".opencode/plugins/loop-guard.ts",
      {
        "mode": "warn_only",
        "windowMs": 30000,
        "minRepeats": 3,
        "requireNoProgress": true,
        "cooldownMs": 60000,
        "maxSessionStates": 200,
        "maxAttemptsPerSession": 60,
        "ignoreTools": [
          "todowrite"
        ],
        "volatileKeys": [
          "timestamp",
          "time",
          "nonce",
          "requestId",
          "requestID",
          "createdAt",
          "updatedAt"
        ]
      }
    ]
  ],
  "tools": {
    "github-triage": false,
    "github-pr-search": false
  }
}
